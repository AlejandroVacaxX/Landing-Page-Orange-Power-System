---
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/700.css';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <!-- NOTE: Fondo navy por defecto para todo el body para mantener el tema oscuro, previene flashes blancos en carga -->
  <body class="bg-brand-navy text-brand-light font-sans antialiased min-h-screen flex flex-col">
    <slot />
  </body>
</html>

