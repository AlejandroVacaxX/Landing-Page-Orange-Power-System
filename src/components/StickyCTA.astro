---
import Button from './ui/Button.astro';
---

<div class="fixed bottom-0 left-0 w-full z-50 bg-[#0B1220]/95 backdrop-blur-md border-t border-brand-light/10 shadow-[0_-4px_20px_rgba(0,0,0,0.5)] py-2">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 md:h-24">
      
      <div class="flex items-center space-x-6">
        <!-- Icono Auriculares -->
        <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 md:w-16 md:h-16 rounded-full border border-brand-orange text-brand-orange">
          <svg class="w-6 h-6 md:w-8 md:h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 12v3a3 3 0 01-3 3h-1a2 2 0 01-2-2v-3a2 2 0 012-2h1.6A7.001 7.001 0 006.4 11H8a2 2 0 012 2v3a2 2 0 01-2 2H7a3 3 0 01-3-3v-3a9 9 0 1116 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 16c-2 0-3-1-3-1s1 3 3 3 3-3 3-3-1 1-3 1z"></path>
          </svg>
        </div>
        
        <!-- Texto (Oculto en moviles, visible en md+) -->
        <div class="hidden sm:flex flex-col">
          <p class="text-xl md:text-2xl font-bold text-brand-white m-0 leading-tight tracking-wide"><span data-i18n="sticky-title">Let's discuss your next power project</span></p>
          <p class="text-sm md:text-base text-brand-light/70 m-0 mt-1"><span data-i18n="sticky-desc">Talk directly with our engineering team.</span></p>
        </div>
      </div>
      
      <!-- Boton -->
      <div>
        <Button variant="solid" href="#contact" className="flex items-center gap-2 group whitespace-nowrap text-sm md:text-base px-6 py-3">
          <span data-i18n="sticky-btn">CONTACT US</span>
          <svg class="w-4 h-4 md:w-5 md:h-5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </Button>
      </div>
      
    </div>
  </div>
</div>
