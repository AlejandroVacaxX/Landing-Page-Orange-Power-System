---
import ServiceCard from './ui/ServiceCard.astro';
---

<!-- SERVICES MARQUEE SECTION: What We Do -->
<section id="services" class="relative py-24 overflow-hidden">
  
  <!-- BACKGROUND SLIDER -->
  <div class="absolute inset-0 z-0">
    <div id="service-slider" class="relative w-full h-full">
      <img src="/images/1-1.jpg" class="slider-img absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-100" />
      <img src="/images/1-2.jpg" class="slider-img absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-0" />
      <img src="/images/1-3.jpg" class="slider-img absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-0" />
      <img src="/images/1-4.jpg" class="slider-img absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-0" />
      <img src="/images/1-5.jpg" class="slider-img absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-0" />
    </div>
    <!-- Overlay oscuro para mantener contraste -->
    <div class="absolute inset-0 bg-[#0B1220]/80"></div>
  </div>

  <div class="relative z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
    <div class="text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-brand-white mb-4"><span data-i18n="srv-title">WHAT WE <span class="text-brand-orange">DO</span></span></h2>
      <div class="h-1 w-20 bg-brand-orange mx-auto"></div>
    </div>
  </div>

  <!-- CONTENEDOR MARQUEE -->
  <div class="relative w-full overflow-hidden flex items-center">
    <div class="flex animate-marquee hover:[animation-play-state:paused] w-max gap-6 px-3">
      
      <!-- SET ORIGINAL (8 tarjetas) -->
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="Microgrids" data-i18n-title="srv-1-t" description="Resilient and autonomous energy systems." data-i18n-desc="srv-1-d" imageSrc="/images/referencia.jpeg" /></div>
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="Generator Synchronization" data-i18n-title="srv-2-t" description="Seamless parallel generator operation." data-i18n-desc="srv-2-d" imageSrc="/images/referencia.jpeg" /></div>
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="Transfer Switches" data-i18n-title="srv-3-t" description="Reliable automatic power transfer solutions." data-i18n-desc="srv-3-d" imageSrc="/images/referencia.jpeg" /></div>
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="Generator Rental" data-i18n-title="srv-4-t" description="Ready-to-deploy industrial power rentals." data-i18n-desc="srv-4-d" imageSrc="/images/referencia.jpeg" /></div>
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="Generation for IPPs" data-i18n-title="srv-5-t" description="Custom power generation for Independent Power Producers." data-i18n-desc="srv-5-d" imageSrc="/images/referencia.jpeg" /></div>
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="Cogeneration" data-i18n-title="srv-6-t" description="High-efficiency combined heat and power systems." data-i18n-desc="srv-6-d" imageSrc="/images/referencia.jpeg" /></div>
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="SCADA Systems" data-i18n-title="srv-7-t" description="Advanced monitoring and control systems." data-i18n-desc="srv-7-d" imageSrc="/images/referencia.jpeg" /></div>
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="Data Centers" data-i18n-title="srv-8-t" description="Mission-critical power for data infrastructure." data-i18n-desc="srv-8-d" imageSrc="/images/referencia.jpeg" /></div>

      <!-- SET DUPLICADO (8 tarjetas) -->
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="Microgrids" data-i18n-title="srv-1-t" description="Resilient and autonomous energy systems." data-i18n-desc="srv-1-d" imageSrc="/images/referencia.jpeg" /></div>
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="Generator Synchronization" data-i18n-title="srv-2-t" description="Seamless parallel generator operation." data-i18n-desc="srv-2-d" imageSrc="/images/referencia.jpeg" /></div>
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="Transfer Switches" data-i18n-title="srv-3-t" description="Reliable automatic power transfer solutions." data-i18n-desc="srv-3-d" imageSrc="/images/referencia.jpeg" /></div>
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="Generator Rental" data-i18n-title="srv-4-t" description="Ready-to-deploy industrial power rentals." data-i18n-desc="srv-4-d" imageSrc="/images/referencia.jpeg" /></div>
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="Generation for IPPs" data-i18n-title="srv-5-t" description="Custom power generation for Independent Power Producers." data-i18n-desc="srv-5-d" imageSrc="/images/referencia.jpeg" /></div>
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="Cogeneration" data-i18n-title="srv-6-t" description="High-efficiency combined heat and power systems." data-i18n-desc="srv-6-d" imageSrc="/images/referencia.jpeg" /></div>
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="SCADA Systems" data-i18n-title="srv-7-t" description="Advanced monitoring and control systems." data-i18n-desc="srv-7-d" imageSrc="/images/referencia.jpeg" /></div>
      <div class="w-[300px] sm:w-[350px] flex-shrink-0"><ServiceCard title="Data Centers" data-i18n-title="srv-8-t" description="Mission-critical power for data infrastructure." data-i18n-desc="srv-8-d" imageSrc="/images/referencia.jpeg" /></div>
      
    </div>
  </div>
  </div>
</section>

<script>
  const images = document.querySelectorAll(".slider-img");
  let currentIndex = 0;
  if (images.length > 0) {
    setInterval(() => {
      images[currentIndex].classList.remove("opacity-100");
      images[currentIndex].classList.add("opacity-0");
      currentIndex = (currentIndex + 1) % images.length;
      images[currentIndex].classList.remove("opacity-0");
      images[currentIndex].classList.add("opacity-100");
    }, 4000);
  }
</script>

