---
---
<section id="hidden-about-section" data-lenis-prevent="true" class="fixed inset-0 z-[100] bg-[#0B1220]/85 backdrop-blur-sm overflow-y-auto hidden opacity-0 transition-opacity duration-500">
  
  <!-- Boton de Cierre -->
  <button id="close-hidden-about" class="fixed top-6 right-6 md:top-10 md:right-10 z-[110] text-brand-light hover:text-brand-orange transition-colors focus:outline-none" aria-label="Close modal">
    <svg class="w-10 h-10 md:w-12 md:h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Estetica Premium: Fondo Ambiental y Glows -->
  <div class="fixed inset-0 pointer-events-none z-0">
    <!-- Patron de cuadricula sutil -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:40px_40px]"></div>
    
    <!-- Halos de luz -->
    <div class="absolute top-1/4 left-1/4 w-[30rem] h-[30rem] bg-brand-orange/10 rounded-full blur-3xl mix-blend-screen opacity-50"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[40rem] h-[40rem] bg-brand-orange/10 rounded-full blur-3xl mix-blend-screen opacity-50"></div>
  </div>

  <!-- Track de Scroll Interno -->
  <div class="relative w-full h-[400vh] z-10" id="modal-scroll-track">
    <!-- Lienzo Sticky Central -->
    <div class="sticky top-0 w-full h-screen flex items-center justify-center overflow-hidden">
      
      
      <!-- Indicador de Scroll -->
      <div id="scroll-indicator" class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center justify-center text-brand-white/80 animate-bounce z-50 transition-opacity duration-300">
        <span class="text-3xl uppercase tracking-widest mb-2 font-semibold">Scroll</span>
        <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>

      <div class="relative w-full max-w-6xl mx-auto px-4 lg:px-8 h-full flex items-center justify-center">
        
        <!-- SLIDE 1 (Mision y Vision) -->
        <div class="gsap-slide absolute w-full grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 opacity-0 transform-gpu" data-tx="-200" data-ty="300" data-rot="-5">
          <!-- Card 1 -->
          <article class="bg-[#050810]/90 backdrop-blur-md border border-brand-light/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] rounded-3xl p-6 sm:p-10 flex flex-col justify-center">
            <h3 class="text-2xl md:text-3xl font-extrabold text-brand-orange mb-6 text-center"><span data-i18n="hid-mision-t">Our Mission</span></h3>
            <p class="text-brand-light/90 text-sm sm:text-base md:text-lg leading-relaxed text-center"><span data-i18n="hid-mision-d">Our mission is to create high-value technological solutions...</span></p>
          </article>
          <!-- Card 2 -->
          <article class="bg-[#050810]/90 backdrop-blur-md border border-brand-light/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] rounded-3xl p-6 sm:p-10 flex flex-col justify-center mt-8 md:mt-0 md:translate-y-12">
            <h3 class="text-2xl md:text-3xl font-extrabold text-brand-orange mb-6 text-center"><span data-i18n="hid-vision-t">Our Vision</span></h3>
            <p class="text-brand-light/90 text-sm sm:text-base md:text-lg leading-relaxed text-center"><span data-i18n="hid-vision-d">Our goal is to transform the energy sector...</span></p>
          </article>
        </div>

        <!-- SLIDE 2 (Cobertura y Mexico) -->
        <div class="gsap-slide absolute w-full grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 opacity-0 transform-gpu" data-tx="300" data-ty="-200" data-rot="5">
          <!-- Card 3 -->
          <article class="bg-[#050810]/90 backdrop-blur-md border border-brand-light/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] rounded-3xl p-6 sm:p-10 flex flex-col justify-center">
            <h3 class="text-2xl md:text-3xl font-extrabold text-brand-orange mb-6 text-center"><span data-i18n="hid-cob-t">Coverage</span></h3>
            <p class="text-brand-light/90 text-sm sm:text-base md:text-lg leading-relaxed text-center"><span data-i18n="hid-cob-d">At Orange we are committed to providing high-quality energy solutions...</span></p>
          </article>
          <!-- Card 4 -->
          <article class="bg-[#050810]/90 backdrop-blur-md border border-brand-light/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] rounded-3xl p-6 sm:p-10 flex flex-col justify-center mt-8 md:mt-0 md:-translate-y-12">
            <h3 class="text-2xl md:text-3xl font-extrabold text-brand-orange mb-6 text-center"><span data-i18n="hid-mex-t">Mexico</span></h3>
            <p class="text-brand-light/90 text-sm sm:text-base md:text-lg leading-relaxed text-center"><span data-i18n="hid-mex-d">Our presence in Mexico is solid and extensive...</span></p>
          </article>
        </div>

        <!-- SLIDE 3 (Latinoamerica y Promesa) -->
        <div class="gsap-slide absolute w-full grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 opacity-0 transform-gpu" data-tx="-100" data-ty="300" data-rot="-2">
          <!-- Card 5 -->
          <article class="bg-[#050810]/90 backdrop-blur-md border border-brand-light/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] rounded-3xl p-6 sm:p-10 flex flex-col justify-center">
            <h3 class="text-2xl md:text-3xl font-extrabold text-brand-orange mb-6 text-center"><span data-i18n="hid-latam-t">Latin America</span></h3>
            <p class="text-brand-light/90 text-sm sm:text-base md:text-lg leading-relaxed text-center"><span data-i18n="hid-latam-d">In addition to our reach in Mexico...</span></p>
          </article>
          <!-- Card 6 -->
          <article class="bg-[#050810]/90 backdrop-blur-md border border-brand-light/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] rounded-3xl p-6 sm:p-10 flex flex-col justify-center mt-8 md:mt-0 md:translate-y-12">
            <h3 class="text-2xl md:text-3xl font-extrabold text-brand-orange mb-6 text-center"><span data-i18n="hid-prom-t">Our Promise</span></h3>
            <p class="text-brand-light/90 text-sm sm:text-base md:text-lg leading-relaxed text-center"><span data-i18n="hid-prom-d">No matter where you are, Orange Power Systems is dedicated...</span></p>
          </article>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const revealBtn = document.getElementById('btn-reveal-about');
  const closeBtn = document.getElementById('close-hidden-about');
  const modal = document.getElementById('hidden-about-section');
  const slides = document.querySelectorAll('.gsap-slide');

  let scrollTriggerInstance: ScrollTrigger | null = null;

  // Configuración inicial de dispersión
  slides.forEach((slide) => {
    const el = slide as HTMLElement;
    const tx = el.getAttribute('data-tx') || '0';
    const ty = el.getAttribute('data-ty') || '0';
    const rot = el.getAttribute('data-rot') || '0';
    gsap.set(el, { x: tx, y: ty, rotation: rot, scale: 0.6, opacity: 0 });
  });

  function initModalAnimation() {
    if (scrollTriggerInstance) {
      scrollTriggerInstance.kill();
    }

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#modal-scroll-track",
        scroller: "#hidden-about-section", // ESTO ES CRITICO PARA MODALES
        start: "top top",
        end: "bottom bottom",
        scrub: 1, // suavizado
      }
    });

    slides.forEach((slide, i) => {
      // 1. Entra al centro de la pantalla
      tl.to(slide, {
        x: 0,
        y: 0,
        rotation: 0,
        scale: 1,
        opacity: 1,
        duration: 1,
        ease: "power2.out"
      });

      // 2. Pausa para lectura
      tl.to(slide, { opacity: 1, duration: 1.5 });

      // 3. Sale difuminandose hacia atrás/arriba si no es el ultimo
      if (i < slides.length - 1) {
        tl.to(slide, {
          y: -150,
          scale: 0.8,
          opacity: 0,
          duration: 1,
          ease: "power2.in"
        });
      }
    });

    scrollTriggerInstance = ScrollTrigger.getAll()[0];
  }

  function openModal() {
    if (!modal) return;
    
    // Preparar UI
    modal.classList.remove('hidden');
    // Forzar reflow
    void modal.offsetWidth;
    modal.classList.remove('opacity-0');
    modal.classList.add('opacity-100');
    
    // Bloquear scroll de la página de fondo
    document.body.style.overflow = 'hidden';
    
    // Resetear scroll del modal a 0
    modal.scrollTop = 0;

    // Inicializar animación y refrescar instancias GSAP con el nuevo scroller
    initModalAnimation();
    ScrollTrigger.refresh();
    
    // Disparar evento para forzar traducción
    const currentLang = document.documentElement.lang || 'en';
    
  }

  function closeModal() {
    if (!modal) return;
    
    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0');
    
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      if (scrollTriggerInstance) {
        scrollTriggerInstance.kill();
      }
    }, 500); // match duration-500
  }

  if (revealBtn) {
    revealBtn.addEventListener('click', openModal);
  }

  
  // Ocultar indicador al hacer scroll
  const modalScrollTrack = document.getElementById('hidden-about-section');
  const scrollIndicator = document.getElementById('scroll-indicator');
  
  if (modalScrollTrack && scrollIndicator) {
    modalScrollTrack.addEventListener('scroll', () => {
      if (modalScrollTrack.scrollTop > 100) {
        scrollIndicator.classList.add('opacity-0');
        scrollIndicator.classList.remove('opacity-100');
      } else {
        scrollIndicator.classList.add('opacity-100');
        scrollIndicator.classList.remove('opacity-0');
      }
    });
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', closeModal);
  }
</script>
