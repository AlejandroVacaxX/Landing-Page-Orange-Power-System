---
---
<section id="hidden-about-section" class="hidden relative w-full h-[500vh] bg-brand-navy">
  <div class="sticky top-0 w-full h-screen overflow-hidden flex items-center justify-center pointer-events-none" id="hidden-about-sticky">
    
    <!-- Contenedor central -->
    <div class="relative w-full max-w-4xl h-full flex items-center justify-center p-4" id="hidden-about-container">
      
      <!-- Card 1 -->
      <article class="gsap-scroll-card absolute w-full max-w-2xl bg-[#0B1220] border border-brand-light/10 shadow-2xl rounded-2xl p-8 md:p-12 opacity-0 transform-gpu" data-tx="-400" data-ty="300" data-rot="-15">
        <h3 class="text-3xl md:text-4xl font-extrabold text-brand-orange mb-6 text-center"><span data-i18n="hid-mision-t">Our Mission</span></h3>
        <p class="text-brand-light/90 text-lg leading-relaxed text-center"><span data-i18n="hid-mision-d">...</span></p>
      </article>

      <!-- Card 2 -->
      <article class="gsap-scroll-card absolute w-full max-w-2xl bg-[#0B1220] border border-brand-light/10 shadow-2xl rounded-2xl p-8 md:p-12 opacity-0 transform-gpu" data-tx="400" data-ty="-300" data-rot="15">
        <h3 class="text-3xl md:text-4xl font-extrabold text-brand-orange mb-6 text-center"><span data-i18n="hid-vision-t">Our Vision</span></h3>
        <p class="text-brand-light/90 text-lg leading-relaxed text-center"><span data-i18n="hid-vision-d">...</span></p>
      </article>

      <!-- Card 3 -->
      <article class="gsap-scroll-card absolute w-full max-w-2xl bg-[#0B1220] border border-brand-light/10 shadow-2xl rounded-2xl p-8 md:p-12 opacity-0 transform-gpu" data-tx="-300" data-ty="-400" data-rot="-10">
        <h3 class="text-3xl md:text-4xl font-extrabold text-brand-orange mb-6 text-center"><span data-i18n="hid-cob-t">Coverage</span></h3>
        <p class="text-brand-light/90 text-lg leading-relaxed text-center"><span data-i18n="hid-cob-d">...</span></p>
      </article>

      <!-- Card 4 -->
      <article class="gsap-scroll-card absolute w-full max-w-2xl bg-[#0B1220] border border-brand-light/10 shadow-2xl rounded-2xl p-8 md:p-12 opacity-0 transform-gpu" data-tx="500" data-ty="200" data-rot="20">
        <h3 class="text-3xl md:text-4xl font-extrabold text-brand-orange mb-6 text-center"><span data-i18n="hid-mex-t">Mexico</span></h3>
        <p class="text-brand-light/90 text-base leading-relaxed text-center"><span data-i18n="hid-mex-d">...</span></p>
      </article>

      <!-- Card 5 -->
      <article class="gsap-scroll-card absolute w-full max-w-2xl bg-[#0B1220] border border-brand-light/10 shadow-2xl rounded-2xl p-8 md:p-12 opacity-0 transform-gpu" data-tx="-400" data-ty="400" data-rot="-25">
        <h3 class="text-3xl md:text-4xl font-extrabold text-brand-orange mb-6 text-center"><span data-i18n="hid-latam-t">Latin America</span></h3>
        <p class="text-brand-light/90 text-base leading-relaxed text-center"><span data-i18n="hid-latam-d">...</span></p>
      </article>

      <!-- Card 6 -->
      <article class="gsap-scroll-card absolute w-full max-w-2xl bg-[#0B1220] border border-brand-light/10 shadow-2xl rounded-2xl p-8 md:p-12 opacity-0 transform-gpu" data-tx="300" data-ty="-300" data-rot="10">
        <h3 class="text-3xl md:text-4xl font-extrabold text-brand-orange mb-6 text-center"><span data-i18n="hid-prom-t">Our Promise</span></h3>
        <p class="text-brand-light/90 text-lg leading-relaxed text-center"><span data-i18n="hid-prom-d">...</span></p>
      </article>

    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const revealBtn = document.getElementById('btn-reveal-about');
  const hiddenSection = document.getElementById('hidden-about-section');
  const cards = document.querySelectorAll('.gsap-scroll-card');

  // Configuración inicial de tarjetas (dispersas)
  cards.forEach((card) => {
    const el = card as HTMLElement;
    const tx = el.getAttribute('data-tx') || '0';
    const ty = el.getAttribute('data-ty') || '0';
    const rot = el.getAttribute('data-rot') || '0';
    gsap.set(el, { x: tx, y: ty, rotation: rot, scale: 0.5, opacity: 0 });
  });

  let scrollTriggerInstance: ScrollTrigger | null = null;

  function initAnimation() {
    if (scrollTriggerInstance) {
      scrollTriggerInstance.kill();
    }

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#hidden-about-section",
        start: "top top",
        end: "bottom bottom",
        scrub: 1, // suavizado nativo de gsap para acompañar a lenis
      }
    });

    cards.forEach((card, i) => {
      // 1. Entra al centro
      tl.to(card, {
        x: 0,
        y: 0,
        rotation: 0,
        scale: 1,
        opacity: 1,
        duration: 1,
        ease: "power2.out"
      });

      // 2. Pausa para leer
      tl.to(card, { opacity: 1, duration: 1.5 });

      // 3. Sale hacia arriba (excepto la ultima, que puede quedarse o salir normal)
      if (i < cards.length - 1) {
        tl.to(card, {
          y: -200,
          scale: 1.1,
          opacity: 0,
          duration: 1,
          ease: "power2.in"
        });
      } else {
        // La última se desvanece más sutilmente
        tl.to(card, {
          opacity: 0,
          duration: 1,
          ease: "power2.in"
        });
      }
    });

    scrollTriggerInstance = ScrollTrigger.getAll()[0];
  }

  if (revealBtn && hiddenSection) {
    revealBtn.addEventListener('click', () => {
      // Remover clase hidden
      hiddenSection.classList.remove('hidden');
      hiddenSection.classList.add('block');
      
      // Inicializar / refrescar GSAP ahora que tiene layout
      initAnimation();
      ScrollTrigger.refresh();

      // Scroll hacia la sección
      setTimeout(() => {
        hiddenSection.scrollIntoView({ behavior: 'smooth' });
      }, 100);
    });
  }
</script>
