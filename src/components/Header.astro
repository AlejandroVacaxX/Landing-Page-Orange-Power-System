---
import Button from './ui/Button.astro';
---

<!-- FIXED NAV -->
<header class="fixed top-0 left-0 w-full z-50 bg-brand-navy/95 backdrop-blur-sm border-b border-brand-light/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- LOGO -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/">
          <span class="text-2xl font-black text-brand-white tracking-widest uppercase">Orange<span class="text-brand-orange">Power</span></span>
        </a>
      </div>
      
      <!-- LINKS DESKTOP -->
      <nav class="hidden md:flex space-x-8 items-center">
        <a href="#products" data-i18n="nav-sol" class="text-sm font-semibold text-brand-white hover:text-brand-orange transition-colors">SOLUTIONS</a>
        <a href="#services" data-i18n="nav-srv" class="text-sm font-semibold text-brand-white hover:text-brand-orange transition-colors">INDUSTRIES</a>
        <a href="#projects" data-i18n="nav-pro" class="text-sm font-semibold text-brand-white hover:text-brand-orange transition-colors">PROJECTS</a>
        <a href="#about" data-i18n="nav-abt" class="text-sm font-semibold text-brand-white hover:text-brand-orange transition-colors">ABOUT</a>
      </nav>

      <!-- BOTON CONTACTO Y MENU MOVIL -->
      <div class="flex items-center space-x-4">
        <!-- Selector de idioma interactivo visible en movil y desktop -->
        <button id="lang-toggle" class="flex items-center space-x-1 text-sm font-semibold cursor-pointer focus:outline-none" aria-label="Cambiar idioma">
          <span id="lang-text-en" class="text-brand-orange transition-colors">EN</span>
          <span class="text-brand-white/30 font-light">|</span>
          <span id="lang-text-es" class="text-brand-white hover:text-brand-orange transition-colors">ES</span>
        </button>
        
        <Button variant="solid" href="#contact" className="hidden md:inline-flex"><span data-i18n="nav-btn">CONTACT</span></Button>
        
        <!-- Botón Hamburguesa -->
        <button type="button" id="mobile-menu-btn" class="md:hidden bg-transparent p-2 rounded-md text-brand-orange focus:outline-none" aria-controls="mobile-menu" aria-expanded="false">
          <span class="sr-only">Open main menu</span>
          <svg class="h-8 w-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- MENU MOVIL DESPLEGABLE -->
  <div id="mobile-menu" class="hidden md:hidden bg-brand-navy border-t border-brand-light/10 absolute w-full">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      <a href="#products" data-i18n="nav-sol" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-brand-white hover:text-brand-orange hover:bg-brand-light/5">SOLUTIONS</a>
      <a href="#services" data-i18n="nav-srv" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-brand-white hover:text-brand-orange hover:bg-brand-light/5">INDUSTRIES</a>
      <a href="#projects" data-i18n="nav-pro" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-brand-white hover:text-brand-orange hover:bg-brand-light/5">PROJECTS</a>
      <a href="#about" data-i18n="nav-abt" class="mobile-link block px-3 py-2 rounded-md text-base font-medium text-brand-white hover:text-brand-orange hover:bg-brand-light/5">ABOUT</a>
      <a href="#contact" data-i18n="nav-btn" class="mobile-link block px-3 py-2 mt-4 text-center rounded-md text-base font-medium bg-brand-orange text-brand-white">CONTACT</a>
    </div>
  </div>
</header>

<script>
  import { translations } from '../i18n.js';
  
  const langToggle = document.getElementById('lang-toggle');
  const textEn = document.getElementById('lang-text-en');
  const textEs = document.getElementById('lang-text-es');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  
  let currentLang = 'en';

 window.updateTranslationsGlobally = updateTranslations;
 function updateTranslations(lang: "en" | "es") {
    const t = translations as Record<string, Record<string, string>>;

    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key && t[lang] && t[lang][key]) {
        el.innerHTML = t[lang][key];
      }
    });

    document.querySelectorAll('[data-i18n-ph]').forEach((el) => {
      const key = el.getAttribute('data-i18n-ph');
      if (key && t[lang] && t[lang][key]) {
        el.setAttribute('placeholder', t[lang][key]);
      }
    });
  }

  // Toggle Language
  if (langToggle && textEn && textEs) {
    langToggle.addEventListener('click', function() {
      if (currentLang === 'en') {
        currentLang = 'es';
        textEn.className = 'text-brand-white hover:text-brand-orange transition-colors';
        textEs.className = 'text-brand-orange transition-colors';
        document.documentElement.lang = 'es';
      } else {
        currentLang = 'en';
        textEn.className = 'text-brand-orange transition-colors';
        textEs.className = 'text-brand-white hover:text-brand-orange transition-colors';
        document.documentElement.lang = 'en';
      }
      updateTranslations(currentLang);
    });
    updateTranslations(currentLang);
  }

  // Toggle Mobile Menu
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
    
    // Cerrar menú al hacer clic en un enlace
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>
