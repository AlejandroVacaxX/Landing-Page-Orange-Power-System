---
---

<section id="about" class="py-24 bg-brand-navy border-t border-brand-light/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Layout Principal -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      
      <!-- Columna Izquierda (Imagen Principal) -->
      <div class="h-64 sm:h-96 lg:h-auto w-full">
        <img 
          src="/images/referencia.jpeg" 
          alt="Orange Power Systems About Us" 
          class="w-full h-full object-cover rounded-3xl shadow-xl opacity-90"
        />
      </div>

      <!-- Columna Derecha (Tarjetas de Texto) -->
      <div class="flex flex-col gap-4">
        
        <!-- Tarjeta Superior (Bienvenida) -->
        <div class="bg-brand-navy border border-brand-light/10 shadow-lg rounded-2xl p-6 sm:p-8 flex flex-col justify-center flex-grow">
          <h2 class="text-2xl sm:text-3xl font-bold text-brand-light/70 mb-2">
            <span data-i18n="abt-welcome-t">Welcome</span>
          </h2>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-brand-orange mb-6">
            <span data-i18n="abt-welcome-st">Orange Power Systems</span>
          </h3>
          <p class="text-brand-light/90 text-lg mb-8 leading-relaxed">
            <span data-i18n="abt-welcome-d">We are a team of engineers passionate about power generation, specializing in the electrical sector. We stand out for working with a high degree of professionalism and the highest quality.</span>
          </p>
          <div>
            <button id="btn-reveal-about" class="bg-brand-light/10 hover:bg-brand-light/20 text-brand-white font-semibold py-3 px-8 rounded-xl transition-colors duration-300">
              <span data-i18n="abt-welcome-btn">Learn more</span>
            </button>
          </div>
        </div>

        <!-- Grid Inferior (2 Tarjetas) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <!-- Tarjeta Izquierda (Qué hacemos) -->
          <div class="bg-brand-navy border border-brand-light/10 shadow-lg rounded-2xl p-6 sm:p-8 text-center flex flex-col">
            <h4 class="text-xl font-bold text-brand-orange mb-4">
              <span data-i18n="abt-what-t">What do we do?</span>
            </h4>
            <p class="text-brand-light/80 text-sm sm:text-base leading-relaxed flex-grow">
              <span data-i18n="abt-what-d">We generate a positive impact on our clients by providing experience, quality, and professionalism to their power generation projects.</span>
            </p>
          </div>

          <!-- Tarjeta Derecha (Cómo lo hacemos) -->
          <div class="bg-brand-navy border border-brand-light/10 shadow-lg rounded-2xl p-6 sm:p-8 text-center flex flex-col">
            <h4 class="text-xl font-bold text-brand-orange mb-4">
              <span data-i18n="abt-how-t">How do we do it?</span>
            </h4>
            <p class="text-brand-light/80 text-sm sm:text-base leading-relaxed flex-grow">
              <span data-i18n="abt-how-d">We are committed to innovative proposals that positively impact our clients and our environment.</span>
            </p>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
