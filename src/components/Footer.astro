---
// Componente simple de pie de pagina
---

<footer class="bg-[#050810] border-t border-brand-light/5 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row justify-between items-center md:items-start gap-8 mb-12">
      
      <!-- Logo extendido (1.jpeg) -->
      <div class="w-full md:w-1/3 flex justify-center md:justify-start">
        <img src="/images/1.jpeg" alt="Orange Power Systems - Engineering, Integration, Commissioning" class="max-w-xs object-contain" />
      </div>
      
      <!-- Navegacion de pie de pagina -->
      <div class="w-full md:w-2/3 flex flex-wrap justify-center md:justify-end gap-x-12 gap-y-6">
        <div class="flex flex-col space-y-3 text-center md:text-left">
          <h4 class="text-brand-white font-bold tracking-wider text-sm"><span data-i18n="ftr-comp">COMPANY</span></h4>
          <a href="#" class="text-brand-light/70 hover:text-brand-orange text-sm transition-colors"><span data-i18n="ftr-c1">About Us</span></a>
          <a href="#" class="text-brand-light/70 hover:text-brand-orange text-sm transition-colors"><span data-i18n="ftr-c2">Careers</span></a>
          <a href="#" class="text-brand-light/70 hover:text-brand-orange text-sm transition-colors"><span data-i18n="ftr-c3">Contact</span></a>
        </div>
        
        <div class="flex flex-col space-y-3 text-center md:text-left">
          <h4 class="text-brand-white font-bold tracking-wider text-sm"><span data-i18n="ftr-srv">SERVICES</span></h4>
          <a href="#" class="text-brand-light/70 hover:text-brand-orange text-sm transition-colors"><span data-i18n="ftr-s1">Engineering</span></a>
          <a href="#" class="text-brand-light/70 hover:text-brand-orange text-sm transition-colors"><span data-i18n="ftr-s2">Rentals</span></a>
          <a href="#" class="text-brand-light/70 hover:text-brand-orange text-sm transition-colors"><span data-i18n="ftr-s3">Maintenance</span></a>
        </div>
      </div>

    </div>
    
    <!-- Copyright -->
    <div class="pt-8 border-t border-brand-light/10 text-center md:text-left flex flex-col md:flex-row justify-between items-center text-sm text-brand-light/50">
      <p>&copy; {new Date().getFullYear()}<span data-i18n="ftr-copy"> Orange Power Systems. All rights reserved.</span></p>
      <div class="mt-4 md:mt-0 space-x-4">
        <a href="#" class="hover:text-brand-white"><span data-i18n="ftr-p1">Privacy Policy</span></a>
        <a href="#" class="hover:text-brand-white"><span data-i18n="ftr-p2">Terms of Service</span></a>
      </div>
    </div>

  </div>
</footer>

