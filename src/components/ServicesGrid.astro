---
import ServiceCard from './ui/ServiceCard.astro';
---

<!-- SERVICES GRID SECTION: What We Do -->
<section id="solutions" class="py-24 bg-brand-navy">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-brand-white mb-4"><span data-i18n="srv-title">WHAT WE <span class="text-brand-orange">DO</span></span></h2>
      <div class="h-1 w-20 bg-brand-orange mx-auto"></div>
    </div>

    <!-- GRID DE SERVICIOS -->
    <!-- NOTE: CSS Grid adaptativo: 1 col (movil), 2 col (tablet md), 3 col (lg), 6 col (laptop xl) para acomodar la tarjeta destacada -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-6 items-stretch">
      
      <!-- TODO: Validar imagenes por cada servicio si existen assets adicionales, ahora usa referencia general -->
      <ServiceCard 
        title="Engineering" data-i18n-title="srv-1-t" 
        description="Comprehensive electrical and mechanical engineering design for power plants." data-i18n-desc="srv-1-d"
        imageSrc="/images/referencia.jpeg"
      />
      
      <ServiceCard 
        title="Integration" data-i18n-title="srv-2-t" 
        description="Seamless integration of power systems into existing infrastructure." data-i18n-desc="srv-2-d"
        imageSrc="/images/referencia.jpeg"
      />
      
      <ServiceCard 
        title="Commissioning" data-i18n-title="srv-3-t" 
        description="Rigorous testing and commissioning to ensure optimal performance." data-i18n-desc="srv-3-d"
        imageSrc="/images/referencia.jpeg"
      />
      
      <!-- Tarjeta especial: Alquiler, usando 7.jpeg -->
      <!-- Implementacion Especial: Animacion 3D y jerarquia visual -->
      <div class="lg:col-span-2 xl:col-span-2 z-10 [perspective:1000px] flex items-center justify-center p-2">
        <div class="h-full w-full animate-spin-slow-y [transform-style:preserve-3d] hover:[animation-play-state:paused] transform lg:scale-105 transition-transform">
          <ServiceCard 
            title="Rental" data-i18n-title="srv-4-t" 
            description="Industrial generator rental ready for rapid deployment." data-i18n-desc="srv-4-d"
            imageSrc="/images/7.jpeg"
          />
        </div>
      </div>
      
      <ServiceCard 
        title="Maintenance" data-i18n-title="srv-5-t" 
        description="Scheduled maintenance and emergency support round the clock." data-i18n-desc="srv-5-d"
        imageSrc="/images/referencia.jpeg"
      />

    </div>
  </div>
</section>

